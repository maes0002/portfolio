---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Home — Maja Estrup" liquidBackground={true} liquidOpacity={1}>
  <main>
    <div class="home-logo">
      <img src="/img/logo.png" alt="Maja Estrup" />
    </div>
  </main>
</MainLayout>

<style>
  .home-logo { position: fixed; inset: 0; display: grid; place-items: center; pointer-events: none; }
  .home-logo img { display: block; width: 60px; height: auto; }
</style>

---
import Localized from "../../components/Localized.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import Text from "../../components/Text.astro";
import ProjectSidebar from "../../components/ProjectSidebar.astro";
const images = [
  "Volunteers wearing Streetcare T-shirts", "A man with his dog outside a church",
  "A conversation on the streets of Copenhagen", "A man sitting with his dog",
  "Two people sharing a moment together", "A Streetcare cargo bike in Copenhagen",
  "Streetcare homepage on a desktop monitor", "Streetcare website on a laptop",
  "Streetcare stories on a laptop", "Streetcare website on a desktop monitor",
  "Streetcare donation page on a laptop",
].map((alt, index) => ({ src: `/img/streetcare/streetcare_${index + 1}.webp`, alt }));
---

<MainLayout title="Streetcare — Maja Estrup">
  <main class="streetcare-page">
    <ProjectSidebar>
      <span slot="title"><Localized en="Case:" /><br /> Streetcare</span>
      <span slot="category"><Localized en="Website" da="Website" /><br /><Localized en="redesign" /></span>
      <span slot="period"><Localized en="Elective exam" da="Valgfag eksamen" /><br /> / 2026</span>
    </ProjectSidebar>

    <div class="case-content">
      <section class="introduction" aria-labelledby="project-heading">
        <div class="hero-collage">
          <img class="volunteers" {...images[0]} />
          <img class="portrait" {...images[1]} />
          <div class="small-pair">
            <img {...images[2]} />
            <img {...images[3]} />
          </div>
        </div>
        <div class="street-collage">
          <img {...images[4]} loading="lazy" />
          <img {...images[5]} loading="lazy" />
        </div>
        <div class="project-copy copy">
          <h2 id="project-heading"><Localized en="The project" da="Projektet" /></h2>
          <Text as="p" teksttype="p_small_reg"><Localized
            en="As part of the Digital Design elective, we redesigned the website for Street Care, a non-profit organization supporting homeless and socially vulnerable people in Copenhagen. Our goal was to create a more user-friendly and visually engaging digital experience that reflects the organization's values."
            da="Som en del af valgfaget Digital Design redesignede vi websitet for Street Care, en nonprofitorganisation, der støtter hjemløse og socialt udsatte mennesker i København. Vores mål var at skabe en mere brugervenlig og visuelt engagerende digital oplevelse, der afspejler organisationens værdier." /></Text>
        </div>
      </section>

      <section class="process-section" aria-labelledby="process-heading">
        <div class="process-images">
          <img {...images[6]} loading="lazy" />
          <img {...images[7]} loading="lazy" />
        </div>
        <div class="copy">
          <h2 id="process-heading"><Localized en="The design process" da="Designprocessen" /></h2>
          <Text as="p" teksttype="p_small_reg"><Localized
            en="Through UX research, ideation, wireframing, and prototyping, we developed a new visual identity with a strong focus on UI design, visual storytelling, and surprise & delight elements. We followed an iterative design process, using usability testing to refine and improve the user experience."
            da="Gennem UX-research, idéudvikling, wireframes og prototyper udviklede vi en ny visuel identitet med fokus på UI-design, visuel storytelling og surprise & delight-elementer. Vi fulgte en iterativ designproces og brugte brugervenlighedstests til at forfine og forbedre brugeroplevelsen." /></Text>
        </div>
      </section>

      <section class="role-section" aria-labelledby="role-heading">
        <div class="copy">
          <h2 id="role-heading"><Localized en="My role" da="Min rolle" /></h2>
          <Text as="p" teksttype="p_small_reg"><Localized
            en="I was involved throughout the entire process, from research and concept development to UI design, prototyping, and frontend development. I placed particular emphasis on usability testing and evaluation, using insights to refine and improve the final solution."
            da="Jeg var involveret gennem hele processen, fra research og konceptudvikling til UI-design, prototyper og frontendudvikling. Jeg lagde særligt vægt på brugervenlighedstests og evaluering og brugte indsigterne til at forfine og forbedre den endelige løsning." /></Text>
        </div>
        <div class="role-images">
          <img {...images[8]} loading="lazy" />
          <img {...images[9]} loading="lazy" />
          <img {...images[10]} loading="lazy" />
        </div>
      </section>
    </div>
  </main>
</MainLayout>

<style>
  .streetcare-page { display: grid; grid-template-columns: 16% minmax(0, 1fr); gap: 24px; padding: 255px 0 160px; font-family: "Geist Mono", monospace; }
  .case-content { min-width: 0; }
  img { display: block; width: 100%; height: auto; }
  .introduction { position: relative; }
  .hero-collage { display: grid; grid-template-columns: 1.9fr 2fr 1fr; align-items: start; gap: 20px; margin-left: 15%; }
  .small-pair { display: grid; gap: 16px; }
  .small-pair img:last-child { width: 75%; }
  .street-collage { display: grid; grid-template-columns: 1fr 2.56fr; align-items: start; gap: 20px; width: 46%; margin: 46px 0 0 auto; }
  .project-copy { position: absolute; bottom: 0; left: 0; width: 46%; }
  .copy h2 { font-size: inherit; font-weight: 500; text-transform: uppercase; margin: 0 0 20px; }
  .copy :global(p) { margin: 0; }
  .process-section { display: grid; grid-template-columns: 52% 1fr; gap: 6%; align-items: end; margin-top: 132px; }
  .process-images { display: grid; grid-template-columns: 1.38fr 1fr; align-items: start; gap: 28px; }
  .role-section { display: grid; grid-template-columns: 1fr 1fr; align-items: end; gap: 44px; margin: 86px 14% 0 15%; }
  .role-images { display: grid; grid-template-columns: .75fr 1fr; align-items: start; gap: 20px; }
  .role-images img:last-child { grid-column: 1 / -1; width: 56%; }
  @media (max-width: 1000px) {
    .streetcare-page { grid-template-columns: 18% minmax(0, 1fr); padding-top: 180px; }
    .hero-collage { margin-left: 0; gap: 12px; }
    .project-copy { position: static; width: 70%; margin-top: 36px; }
    .street-collage { width: 58%; gap: 12px; margin-top: 28px; }
    .process-section { margin-top: 80px; grid-template-columns: 1fr; gap: 32px; }
    .process-images { width: 80%; }
    .process-section .copy { max-width: 480px; margin-left: auto; }
    .role-section { margin: 80px 0 0; gap: 28px; }
  }
  @media (max-width: 640px) {
    .streetcare-page { display: block; padding: 140px 0 80px; }
    .hero-collage { grid-template-columns: 1fr 1fr; gap: 12px; }
    .small-pair { grid-column: 1 / -1; grid-template-columns: 1fr 1fr; width: 62%; gap: 12px; }
    .small-pair img:last-child { width: 100%; }
    .street-collage { width: 80%; margin-top: 24px; }
    .project-copy { width: 100%; margin-top: 40px; }
    .process-section { margin-top: 56px; }
    .process-images { width: 100%; gap: 16px; }
    .role-section { display: flex; flex-direction: column-reverse; align-items: stretch; margin-top: 56px; gap: 32px; }
    .role-images { width: 85%; margin-left: auto; gap: 16px; }
  }
</style>

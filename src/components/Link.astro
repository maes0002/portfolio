---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  variant?: "text" | "logo" | "image";
}

const { href, variant = "text", class: className, target: requestedTarget, rel: requestedRel, ...attributes } = Astro.props;
const isExternalWebsite = /^(https?:)?\/\//i.test(href);
const target = requestedTarget ?? (isExternalWebsite ? "_blank" : undefined);
const rel = target === "_blank"
  ? [...new Set([...(requestedRel ?? "").split(/\s+/).filter(Boolean), "noopener", "noreferrer"])].join(" ")
  : requestedRel;
const label = await Astro.slots.render("default");
---

<a href={href} target={target} rel={rel} class:list={["text-style", { "logo-link": variant === "logo", "image-link": variant === "image" }, className]} {...attributes}>
  {variant === "image" ? <Fragment set:html={label} /> : (
  <span class="label-window">
    <span class="label-track">
      <span class="label" set:html={label} />
      <span class="label" aria-hidden="true" set:html={label} />
    </span>
  </span>
  )}
</a>

<style>
  .text-style {
    position: relative;
    display: inline-block;
    font-family: "Geist Mono", monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: -0.06em;
    color: inherit;
    text-decoration: none;
    padding-block: 3px;
    vertical-align: baseline;
  }

  .label-window {
    position: relative;
    display: block;
    overflow: hidden;
    height: 1lh;
    line-height: normal;
  }

  .label-track {
    display: block;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .label { display: block; height: 1lh; white-space: nowrap; }
  @media (max-width: 640px) {
    .label-window, .label { height: 1lh; }
    .logo-link .label-window, .logo-link .label { height: auto; }
  }

  .text-style::after {
    content: "";
    position: absolute;
    inset: auto 0 1px;
    height: 1px;
    background: currentColor;
    pointer-events: none;
  }

  .text-style:focus-visible .label-track { transform: translateY(-50%); }
  .text-style:focus-visible::after { animation: underline-sweep 500ms ease both; }

  @media (hover: hover) and (pointer: fine) {
    .text-style:hover .label-track { transform: translateY(-50%); }
    .text-style:hover::after { animation: underline-sweep 500ms ease both; }
  }

  @keyframes underline-sweep {
    0% { transform: scaleX(1); transform-origin: right; }
    49% { transform: scaleX(0); transform-origin: right; }
    50% { transform: scaleX(0); transform-origin: left; }
    100% { transform: scaleX(1); transform-origin: left; }
  }

  a.text-style:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 4px;
  }
  .logo-link .label-window, .logo-link .label { height: auto; }
  .logo-link .label[aria-hidden] { display: none; }
  .logo-link:is(:hover, :focus-visible) .label-track { transform: none; }
  .logo-link::after { display: none; }
  .logo-link { transition: opacity 200ms ease; }
  .logo-link:is(:hover, :focus-visible) { opacity: .65; }
  .image-link { display: block; overflow: hidden; padding: 0; }
  .image-link::after { display: none; }
  .image-link:is(:hover, :focus-visible) { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .text-style .label-track,
    .text-style:is(:hover, :focus-visible) .label-track { transition: none; transform: none; }
    .text-style::after,
    .text-style:is(:hover, :focus-visible)::after { animation: none; }
    .text-style:is(:hover, :focus-visible) { opacity: 0.7; }
  }
</style>

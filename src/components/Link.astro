---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
}

const { href, class: className, ...attributes } = Astro.props;
---

<a href={href} class:list={["text-style", className]} {...attributes}>
  <span class="label-window">
    <span class="label"><slot /></span>
    <span class="label label-copy" aria-hidden="true"><slot /></span>
  </span>
</a>

<style>
  .text-style {
    position: relative;
    display: inline-block;
    font-family: "Geist Mono", monospace;
    color: inherit;
    text-decoration: none;
    padding-block: 3px;
    vertical-align: baseline;
  }

  .label-window {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .label {
    display: block;
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .label-copy { position: absolute; inset: 100% 0 auto; }

  .text-style::after {
    content: "";
    position: absolute;
    inset: auto 0 1px;
    height: 1px;
    background: currentColor;
    pointer-events: none;
  }

  .text-style:focus-visible .label { transform: translateY(-100%); }
  .text-style:focus-visible::after { animation: underline-sweep 500ms ease both; }

  @media (hover: hover) and (pointer: fine) {
    .text-style:hover .label { transform: translateY(-100%); }
    .text-style:hover::after { animation: underline-sweep 500ms ease both; }
  }

  @keyframes underline-sweep {
    0% { transform: scaleX(1); transform-origin: right; }
    49% { transform: scaleX(0); transform-origin: right; }
    50% { transform: scaleX(0); transform-origin: left; }
    100% { transform: scaleX(1); transform-origin: left; }
  }

  a.text-style:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .text-style .label,
    .text-style:is(:hover, :focus-visible) .label { transition: none; transform: none; }
    .text-style::after,
    .text-style:is(:hover, :focus-visible)::after { animation: none; }
    .text-style:is(:hover, :focus-visible) { opacity: 0.7; }
  }
</style>

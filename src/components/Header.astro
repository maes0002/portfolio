---
import Text from "../components/Text.astro";
import Link from "../components/Link.astro";
---

<header class="site-header">
  <Text as="p" teksttype="p_small_reg" class="brand">
    MAJA ESTRUP<br />
    DIGITAL DESIGNER
  </Text>

  <nav aria-label="Hovedmenu">
    <Link href="/work">MY WORK</Link>
    <span class="resume-link">
      <Link href="/resume" aria-describedby="resume-hint">RESUMÉ</Link>
      <span id="resume-hint" class="resume-hint">Download PDF ↗</span>
    </span>
    <Link href="/my-style">MY STYLE</Link>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px;
    font-size: 13px;
    font-weight: 500;
  }

  .site-header :global(.brand) {
    margin: 0;
    line-height: 1.4;
    font-weight: 500;
    white-space: nowrap;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  nav :global(a) {
    white-space: nowrap;
  }

  .resume-link { position: relative; }
  .resume-hint {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translate(-50%, -4px);
    padding: 6px 9px;
    border: 1px solid rgb(0 0 0 / 15%);
    border-radius: 3px;
    background: rgb(252 252 252 / 92%);
    font-family: "Geist Mono", monospace;
    font-size: 10px;
    font-weight: 400;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: opacity 180ms ease, transform 180ms ease, visibility 180ms;
  }
  .resume-link:is(:hover, :focus-within) .resume-hint {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  @media (hover: none) {
    .resume-hint {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .resume-hint { transition: none; }
  }

  @media (max-width: 540px) {
    .site-header {
      flex-wrap: wrap;
      gap: 16px;
      padding: 16px;
    }
    nav {
      gap: 24px;
    }
  }
</style>

<div class="custom-cursor" data-custom-cursor aria-hidden="true">
  <span class="cursor-dot"></span>
  <span class="cursor-ring"></span>
</div>

<style>
  .custom-cursor {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
  }
  .custom-cursor.visible {
    opacity: 1;
  }
  .cursor-dot,
  .cursor-ring {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 50%;
    will-change: transform;
  }
  .cursor-dot {
    width: 5px;
    height: 5px;
    background: #000;
  }
  .cursor-ring {
    width: 30px;
    height: 30px;
    border: 1px solid rgb(0 0 0 / 75%);
    transition: width 200ms ease, height 200ms ease, background 200ms ease;
  }
  .custom-cursor.over-link .cursor-ring {
    width: 48px;
    height: 48px;
    background: rgb(0 0 0 / 6%);
  }
  .custom-cursor.pressed .cursor-ring {
    width: 22px;
    height: 22px;
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :global(html.has-custom-cursor),
    :global(html.has-custom-cursor a),
    :global(html.has-custom-cursor button) {
      cursor: none;
    }
  }
</style>

<script>
  let cleanup = () => {};
  function mount() {
    cleanup();
    const cursor = document.querySelector<HTMLElement>("[data-custom-cursor]");
    if (!cursor) return;
    const dot = cursor.querySelector<HTMLElement>(".cursor-dot")!;
    const ring = cursor.querySelector<HTMLElement>(".cursor-ring")!;
    const enabled = matchMedia("(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)");
    let x = 0,
      y = 0,
      ringX = 0,
      ringY = 0;
    let frame = 0,
      previousTime = 0;
    let visible = false;

    function animate(time: number) {
      frame = 0;
      if (!visible || !enabled.matches) return;
      const dt = Math.min((time - previousTime) / 1000 || 1 / 60, 0.05);
      previousTime = time;
      const blend = 1 - Math.exp(-14 * dt);
      ringX += (x - ringX) * blend;
      ringY += (y - ringY) * blend;
      dot.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;
      ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0) translate(-50%, -50%)`;
      if (Math.abs(x - ringX) + Math.abs(y - ringY) > 0.1) frame = requestAnimationFrame(animate);
    }
    function hide() {
      visible = false;
      cursor!.classList.remove("visible", "over-link", "pressed");
      document.documentElement.classList.remove("has-custom-cursor");
      cancelAnimationFrame(frame);
      frame = 0;
    }
    function move(event: PointerEvent) {
      if (!enabled.matches || event.pointerType !== "mouse") {
        hide();
        return;
      }
      const target = event.target instanceof Element ? event.target : null;
      // Preserve native text and editing cursors.
      if (target?.closest("input, textarea, select, [contenteditable]:not([contenteditable='false'])")) {
        hide();
        return;
      }
      x = event.clientX;
      y = event.clientY;
      if (!visible) {
        ringX = x;
        ringY = y;
        visible = true;
        previousTime = performance.now();
      }
      cursor!.classList.add("visible");
      cursor!.classList.toggle("over-link", !!target?.closest("a, button, [role='button']"));
      document.documentElement.classList.add("has-custom-cursor");
      if (!frame) frame = requestAnimationFrame(animate);
    }
    function press(event: PointerEvent) {
      if (visible && event.pointerType === "mouse") cursor!.classList.add("pressed");
    }
    function release() {
      cursor!.classList.remove("pressed");
    }
    document.addEventListener("pointermove", move, { passive: true });
    document.addEventListener("pointerdown", press, { passive: true });
    document.addEventListener("pointerup", release, { passive: true });
    document.addEventListener("pointercancel", hide);
    document.documentElement.addEventListener("pointerleave", hide);
    window.addEventListener("blur", hide);
    document.addEventListener("visibilitychange", hide);
    enabled.addEventListener("change", hide);
    cleanup = () => {
      hide();
      document.removeEventListener("pointermove", move);
      document.removeEventListener("pointerdown", press);
      document.removeEventListener("pointerup", release);
      document.removeEventListener("pointercancel", hide);
      document.documentElement.removeEventListener("pointerleave", hide);
      window.removeEventListener("blur", hide);
      document.removeEventListener("visibilitychange", hide);
      enabled.removeEventListener("change", hide);
    };
  }
  document.addEventListener("astro:before-swap", () => cleanup());
  document.addEventListener("astro:page-load", mount);
  window.addEventListener("pagehide", () => cleanup());
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) mount();
  });
  mount();
</script>
